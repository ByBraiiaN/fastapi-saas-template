# APP
APP_NAME=fastapi-saas-template
APP_ENV=development
APP_DEBUG=False
APP_URL=http://localhost:8010
LOG_LEVEL=INFO
LOG_TO_FILE=true
SQL_ECHO=false

# DATABASE (async for API, sync for Celery, isolated test DB)
# Compose overrides the hostnames to db/redis; keep localhost for scripts/dev.sh.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_test_db

# JWT (values are seconds; use 32+ characters in production)
ALGORITHM=HS256
ACCESS_SECRET_KEY=CHANGE_ME_ACCESS_32_CHARS_MINIMUM____
ACCESS_TOKEN_EXPIRE=900
REFRESH_SECRET_KEY=CHANGE_ME_REFRESH_32_CHARS_MINIMUM___
REFRESH_TOKEN_EXPIRE=2592000
VALIDATION_SECRET_KEY=CHANGE_ME_VALIDATION_32_CHARS_MIN____
VALIDATION_TOKEN_EXPIRE=900

# MAIL (use Mailpit locally: localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# SOCIAL LOGIN - GOOGLE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/social/callback/google
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# SOCIAL LOGIN - GITHUB
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8010/auth/social/callback/github
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USER_API=https://api.github.com/user
GITHUB_EMAILS=https://api.github.com/user/emails

# INFRA
REDIS_URL=redis://localhost:6379/0
CELERY_WORKER_URL=redis://localhost:6379/0
CELERY_BEAT_URL=redis://localhost:6379/1

# BILLING - Paddle Billing (Merchant of Record, sandbox by default)
# Fully optional in sandbox: without keys the web app works and only checkout/webhook return a friendly 503.
# API key: Paddle Dashboard > Developer tools > Authentication > API keys > New (shown once)
# Webhook secret: Paddle Dashboard > Developer tools > Notifications > your destination > secret
# Client token: Paddle Dashboard > Developer tools > Authentication > Client-side tokens (future Paddle.js overlay only)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
FRONTEND_URL=http://localhost:3010

# INITIAL ADMIN (idempotent seed: backend/scripts/seed_admin.py)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# AI (admin assistant, Groq-compatible)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:8010
